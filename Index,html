eyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}@media(max-width:640px){.cover{grid-template-columns:1fr;min-height:100svh}.cover-art{border-right:0;padding:24px 20px 0}.arch{height:165px;width:130px;aspect-ratio:auto;border-radius:80px 80px 3px 3px;padding:15px}.arch:after{inset:7px}.monogram{font-size:43px}.monogram small{font-size:24px;margin:7px 0}.cover-art .flower{width:95px;height:140px}.cover-copy{padding:26px 24px 42px}.cover-copy h1{font-size:36px;margin:16px 0}.amp{margin:6px 0}.cover-copy .date{margin-bottom:16px}.cover-copy .divider{margin-bottom:20px}.guest-box{padding-top:16px;margin-top:3px}.cover .button{margin-top:18px}.intro{padding:70px 25px 45px}.section{padding:55px 24px}.couple{grid-template-columns:1fr;gap:20px;max-width:330px}.person{padding:28px 14px}.join{line-height:1}.person h3{font-size:30px}.nav a{padding:10px 12px}.event-card{padding:32px 20px}.closing{padding-bottom:65px}.footer{padding-bottom:115px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
