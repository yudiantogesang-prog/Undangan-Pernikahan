<body>
<!-- Ubah data undangan pada objek UNDANGAN di bagian script paling bawah. Tidak menggunakan layanan eksternal. -->
<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><defs><symbol id="botanical" viewBox="0 0 180 260"><g fill="none" stroke="currentColor" stroke-width="1.2"><path d="M80 255C95 190 57 110 100 15M85 213C40 190 25 161 19 135M83 167C121 146 144 113 150 78M82 118C48 99 33 68 38 44M91 61C126 47 137 22 135 5"/><path d="M53 190Q13 188 12 153Q45 152 53 190ZM36 164Q9 142 22 115Q48 129 36 164ZM105 149Q105 113 137 105Q148 135 105 149ZM130 119Q123 88 153 66Q170 98 130 119ZM63 101Q33 94 31 63Q60 62 63 101ZM88 76Q68 49 86 23Q108 43 88 76ZM112 46Q112 14 138 7Q148 33 112 46Z"/></g></symbol></defs></svg>
<section class="cover" id="sampul" aria-label="Sampul undangan">
 <div class="cover-art" aria-hidden="true"><div class="arch"><svg class="flower left"><use href="#botanical"/></svg><svg class="flower right"><use href="#botanical"/></svg><div class="monogram"><span data-field="inisialPria">G</span><small>&amp;</small><span data-field="inisialWanita">...</span></div></div></div>
 <div class="cover-copy"><p class="eyebrow">Undangan Pernikahan</p><h1><span data-field="namaPria">Gesang Yudianto</span><span class="amp">&amp;</span><span data-field="namaWanita">...</span></h1><div class="divider"></div><p class="date" data-field="tanggal">...</p><div class="guest-box"><p>Kepada Yth.</p><div class="guest" id="tamu">Bapak/Ibu/Saudara/i</div></div><button class="button" id="buka" type="button"><span aria-hidden="true">✉</span> Buka Undangan</button></div>
</section>
<main id="isi" hidden>
 <section class="intro" id="beranda" tabindex="-1"><div class="shell"><p class="eyebrow">Sebuah awal, bersama</p><div class="ornament" aria-hidden="true">✧</div><h2><span data-field="namaPria">Gesang Yudianto</span><span class="amp">&amp;</span><span data-field="namaWanita">...</span></h2><p class="lead">Dengan penuh kebahagiaan, kami mengundang Bapak/Ibu/Saudara/i untuk hadir dan menjadi bagian dari hari istimewa kami.</p><span class="tag" data-field="tanggal">...</span></div></section>
 <section class="section" id="pasangan"><div class="shell"><p class="eyebrow muted">Dua hati, satu perjalanan</p><h2 class="section-title">Kami yang Berbahagia</h2><div class="couple"><article class="person"><div class="medallion" aria-hidden="true" data-field="inisialPria">G</div><h3 data-field="namaPria">Gesang Yudianto</h3><p>Mempelai Pria</p></article><div class="join" aria-hidden="true">&amp;</div><article class="person"><div class="medallion" aria-hidden="true" data-field="inisialWanita">...</div><h3 data-field="namaWanita">...</h3><p>Mempelai Wanita</p></article></div></div></section>
 <section class="section event-section" id="acara"><p class="eyebrow muted">Hari yang dinantikan</p><h2 class="section-title">Waktu &amp; Tempat</h2><p class="section-desc">Kehadiran dan doa restu Anda akan menjadi bagian berharga dari kebahagiaan kami.</p><article class="event-card"><div class="emblem" aria-hidden="true">✧</div><h3>Acara Pernikahan</h3><div class="event-row"><div class="label">Tanggal</div><div class="value" data-field="tanggal">...</div></div><div class="event-row"><div class="label">Waktu</div><div class="value" data-field="waktu">...</div></div><div class="event-row"><div class="label">Lokasi</div><div class="value" data-field="lokasi">...</div></div><div class="event-row"><div class="label">Alamat</div><div class="value" style="font-size:16px" data-field="alamat">...</div></div></article></section>
 <section class="section closing" id="penutup"><div class="shell"><p class="eyebrow">Sampai jumpa di hari bahagia</p><h2>Terima Kasih</h2><p class="section-desc">Merupakan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.</p><p class="names"><span data-field="namaPria">Gesang Yudianto</span><br><span style="color:#cbb184;font-style:italic">&amp;</span><br><span data-field="namaWanita">...</span></p><button class="button" id="salin" type="button">Salin Teks Undangan</button></div></section>
 <footer class="footer">DENGAN CINTA &amp; KEBAHAGIAAN</footer>
</main>
<nav class="nav" id="navigasi" aria-label="Navigasi undangan" hidden><a href="#beranda">Beranda</a><a href="#pasangan">Pasangan</a><a href="#acara">Acara</a><a href="#penutup">Penutup</a></nav>
<div class="toast" role="status" id="pesan" hidden></div>
<noscript><style>.cover{display:none}main[hidden]{display:block}</style><p class="no-script">Aktifkan JavaScript untuk menggunakan tombol interaktif.</p></noscript>
<script>
// Ganti nilai berikut saat detail acara sudah tersedia.
const UNDANGAN = {
  namaPria: 'Gesang Yudianto',
  namaWanita: '...',
  tanggal: '...',
  waktu: '...',
  lokasi: '...',
  alamat: '...'
};
const data = {...UNDANGAN, inisialPria: UNDANGAN.namaPria.trim().charAt(0), inisialWanita: UNDANGAN.namaWanita === '...' ? '...' : UNDANGAN.namaWanita.trim().charAt(0)};
document.querySelectorAll('[data-field]').forEach(el => { el.textContent = data[el.dataset.field] || '...'; });
document.title = `Undangan Pernikahan · ${data.namaPria} & ${data.namaWanita}`;
const namaTamu = new URLSearchParams(window.location.search).get('to');
if (namaTamu && namaTamu.trim()) document.getElementById('tamu').textContent = namaTamu.trim().slice(0, 120);
document.getElementById('buka').addEventListener('click', () => {
  document.getElementById('isi').hidden = false;
  document.getElementById('navigasi').hidden = false;
  document.getElementById('sampul').classList.add('opened');
  document.getElementById('beranda').classList.add('fade-in');
  window.scrollTo(0, 0);
  document.getElementById('beranda').focus({preventScroll: true});
});
let pesanTimer;
function tampilPesan(teks) { const el = document.getElementById('pesan'); el.textContent = teks; el.hidden = false; clearTimeout(pesanTimer); pesanTimer = setTimeout(() => { el.hidden = true; }, 4500); }
document.getElementById('salin').addEventListener('click', async () => {
  const online = ['http:', 'https:'].includes(location.protocol);
  const link = online ? '\n\nUndangan selengkapnya:\n' + location.href.split('#')[0] : '';
  const teks = `Dengan penuh kebahagiaan, kami mengundang Bapak/Ibu/Saudara/i untuk hadir dalam pernikahan:\n\n${data.namaPria} & ${data.namaWanita}\n\nTanggal: ${data.tanggal}\nWaktu: ${data.waktu}\nLokasi: ${data.lokasi}\nAlamat: ${data.alamat}\n\nKehadiran dan doa restu Anda sangat berarti bagi kami.${link}`;
  try {
    if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(teks); }
    else { const area = document.createElement('textarea'); area.value = teks; area.style.position = 'fixed'; area.style.opacity = '0'; document.body.appendChild(area); area.select(); const ok = document.execCommand('copy'); area.remove(); if (!ok) throw new Error('copy'); }
    tampilPesan(online ? 'Teks undangan dan tautan berhasil disalin.' : 'Teks undangan disalin. Publikasikan web untuk mendapatkan tautan.');
  } catch (e) { tampilPesan('Penyalinan tidak didukung browser ini. Silakan salin detail undangan secara manual.'); }
});
</script>
